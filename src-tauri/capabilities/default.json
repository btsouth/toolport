{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    "process:allow-exit",
    "dialog:allow-save",
    "dialog:allow-open",
    "deep-link:default",
    "notification:default",
    "autostart:default",
    "window-state:default"
  ]
}
