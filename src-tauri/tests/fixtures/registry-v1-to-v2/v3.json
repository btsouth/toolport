{
  "activeProfileId": "default",
  "blockOnInjection": false,
  "clientManagedEntries": {
    "claude-desktop": {
      "args": [],
      "command": "toolport-gateway",
      "env": {
        "TOOLPORT_CLIENT_ID": "claude-desktop"
      },
      "transport": "sharedHttp",
      "updatedAt": 1790000000000,
      "url": "http://127.0.0.1:8765/mcp"
    }
  },
  "clientScopes": {
    "cursor": "default"
  },
  "codeMode": true,
  "confirmDestructive": false,
  "defaultAccessContextId": "default",
  "defaultAccessLegacyPolicy": true,
  "denyDestructive": false,
  "humanApproval": false,
  "humanApprovalAllow": ["github/search_code"],
  "lazyDiscovery": true,
  "pinnedTools": {
    "github": ["get_me"]
  },
  "profiles": [
    {
      "enabledServerIds": ["github"],
      "id": "default",
      "name": "Default",
      "toolScope": {
        "github": ["search_code"]
      }
    }
  ],
  "quarantineOnDrift": false,
  "safetyLevel": "off",
  "servers": [
    {
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "command": "npx",
      "disabledTools": ["delete_repository"],
      "enabled": true,
      "env": [
        {
          "key": "GITHUB_TOKEN",
          "secret": true
        }
      ],
      "id": "github",
      "inheritEnv": true,
      "name": "GitHub",
      "source": "manual",
      "transport": "stdio"
    }
  ],
  "toolOverrides": {
    "github": {
      "create_issue": {
        "description": "Open an issue"
      }
    }
  },
  "version": 3,
  "accessUpgradeNoticeDismissed": false
}
