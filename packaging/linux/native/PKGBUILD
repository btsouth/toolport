# Maintainer: Tyler South <tsouth2@gmail.com>
# The archive is expected to unpack to toolport-$pkgver.
pkgname=toolport
pkgver=1.18.0
pkgrel=1
pkgdesc='One local MCP gateway for every AI client, with a native GTK shell'
arch=('x86_64')
url='https://github.com/btsouth/toolport'
license=('MIT')
# No libsecret: on Linux the keyring crate uses sync-secret-service, which talks
# to the Secret Service over D-Bus rather than linking libsecret, and namcap
# confirms neither binary links it. A provider is a runtime choice, and without
# one Toolport falls back to its own encrypted file backend.
depends=('gtk4' 'libadwaita' 'glib2' 'dbus' 'hicolor-icon-theme')
optdepends=('gnome-keyring: store credentials in the system keyring instead of the encrypted file backend'
            'kwallet: same, on KDE')
makedepends=('cargo' 'desktop-file-utils' 'appstream' 'zip')
# The GTK shell replaces the Tauri one on Linux rather than sitting beside it:
# both read the same ~/.config/Toolport, only one can hold the approval broker's
# owner lock, and both claim /usr/bin/toolport-gateway. `replaces` upgrades an
# existing preview install in place.
conflicts=('toolport-bin' 'toolport-native-preview')
replaces=('toolport-native-preview')
options=('!lto')
source=("toolport-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('900dfa348cda6daf5b9d75cad8ee820e9ff39ff21614e9c855f5afcda3046033')

build() {
  cd "toolport-$pkgver/src-tauri"
  cargo build --release --locked --no-default-features \
    --features gtk-desktop --bin toolport-gtk --bin toolport-gateway
}

check() {
  cd "toolport-$pkgver/src-tauri"
  cargo test --locked --no-default-features --features gtk-desktop \
    --lib linux_native::
}

package() {
  cd "toolport-$pkgver"
  install -Dm755 src-tauri/target/release/toolport-gtk \
    "$pkgdir/usr/bin/toolport-gtk"
  install -Dm755 src-tauri/target/release/toolport-gateway \
    "$pkgdir/usr/bin/toolport-gateway"
  install -Dm644 packaging/linux/native/com.tsout.Toolport.desktop \
    "$pkgdir/usr/share/applications/com.tsout.Toolport.desktop"
  install -Dm644 packaging/linux/native/com.tsout.Toolport.metainfo.xml \
    "$pkgdir/usr/share/metainfo/com.tsout.Toolport.metainfo.xml"
  install -Dm644 src-tauri/icons/32x32.png \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/toolport.png"
  install -Dm644 src-tauri/icons/128x128.png \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/toolport.png"
  install -Dm644 src-tauri/icons/128x128@2x.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/toolport.png"
  install -d "$pkgdir/usr/share/toolport/agent-plugin"
  (cd packaging/agent-plugin && zip -qr \
    "$pkgdir/usr/share/toolport/agent-plugin/toolport-agent-plugin.zip" toolport)
  install -Dm644 LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
