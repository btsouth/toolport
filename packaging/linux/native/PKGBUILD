# Maintainer preview package. The release archive is expected to unpack to
# toolport-$pkgver and is replaced with a tagged source URL at release time.
pkgname=toolport-native-preview
pkgver=1.17.0
pkgrel=1
pkgdesc='Native GTK Toolport shell and local MCP gateway'
arch=('x86_64')
url='https://github.com/tsouth89/toolport'
license=('MIT')
depends=('gtk4' 'libadwaita' 'libsecret' 'glib2' 'dbus' 'hicolor-icon-theme')
makedepends=('cargo' 'desktop-file-utils' 'appstream' 'zip')
provides=('toolport-native-preview')
options=('!lto')
source=("toolport-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "toolport-$pkgver/src-tauri"
  cargo build --release --locked --no-default-features \
    --features gtk-desktop --bin toolport-gtk --bin toolport-gateway
}

check() {
  cd "toolport-$pkgver/src-tauri"
  cargo test --locked --no-default-features --features gtk-desktop \
    --lib linux_native::
}

package() {
  cd "toolport-$pkgver"
  install -Dm755 src-tauri/target/release/toolport-gtk \
    "$pkgdir/usr/bin/toolport-gtk"
  install -Dm755 src-tauri/target/release/toolport-gateway \
    "$pkgdir/usr/bin/toolport-gateway"
  install -Dm644 packaging/linux/native/com.tsout.Toolport.NativePreview.desktop \
    "$pkgdir/usr/share/applications/com.tsout.Toolport.NativePreview.desktop"
  install -Dm644 packaging/linux/native/com.tsout.Toolport.NativePreview.metainfo.xml \
    "$pkgdir/usr/share/metainfo/com.tsout.Toolport.NativePreview.metainfo.xml"
  install -Dm644 src-tauri/icons/32x32.png \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/toolport.png"
  install -Dm644 src-tauri/icons/128x128.png \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/toolport.png"
  install -Dm644 src-tauri/icons/128x128@2x.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/toolport.png"
  install -d "$pkgdir/usr/share/toolport/agent-plugin"
  (cd packaging/agent-plugin && zip -qr \
    "$pkgdir/usr/share/toolport/agent-plugin/toolport-agent-plugin.zip" toolport)
  install -Dm644 LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
