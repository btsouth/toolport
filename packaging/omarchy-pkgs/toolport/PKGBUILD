# Maintainer: Tyler South <tsouth2@gmail.com>

pkgname=toolport
pkgver=1.18.0
pkgrel=1
pkgdesc='Native MCP gateway manager for AI coding agents'
arch=('x86_64')
url='https://github.com/tsouth89/toolport'
license=('MIT')
depends=('gtk4' 'libadwaita' 'pango' 'glib2' 'dbus' 'org.freedesktop.secrets' 'hicolor-icon-theme')
makedepends=('cargo' 'desktop-file-utils' 'appstream' 'zip')
provides=('toolport')
conflicts=('toolport-bin' 'toolport-native-preview')
replaces=('toolport-bin' 'toolport-native-preview')
options=('!lto')
source=("toolport-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Replace from the immutable v1.18.0 source archive after the release tag exists.
sha256sums=('REPLACE_WITH_V1_18_0_SOURCE_SHA256')

build() {
  cd "toolport-$pkgver/src-tauri"
  cargo build --release --locked --no-default-features \
    --features gtk-desktop --bin toolport --bin toolport-gateway
}

check() {
  cd "toolport-$pkgver/src-tauri"
  cargo test --locked --no-default-features --features gtk-desktop \
    --lib linux_native::
}

package() {
  cd "toolport-$pkgver"
  install -Dm755 src-tauri/target/release/toolport \
    "$pkgdir/usr/bin/toolport"
  install -Dm755 src-tauri/target/release/toolport-gateway \
    "$pkgdir/usr/bin/toolport-gateway"
  install -Dm644 packaging/linux/native/app.toolport.Toolport.desktop \
    "$pkgdir/usr/share/applications/app.toolport.Toolport.desktop"
  install -Dm644 packaging/linux/native/app.toolport.Toolport.metainfo.xml \
    "$pkgdir/usr/share/metainfo/app.toolport.Toolport.metainfo.xml"
  install -Dm644 src-tauri/icons/32x32.png \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/toolport.png"
  install -Dm644 src-tauri/icons/128x128.png \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/toolport.png"
  install -Dm644 src-tauri/icons/128x128@2x.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/toolport.png"
  install -d "$pkgdir/usr/share/toolport/agent-plugin"
  (cd packaging/agent-plugin && zip -qr \
    "$pkgdir/usr/share/toolport/agent-plugin/toolport-agent-plugin.zip" toolport)
  install -Dm644 LICENSE \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY_NOTICES.md \
    "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
}
